{
  "name": "couple-site",
  "version": "1.0.0",
  "description": "情侣小站 - 记录我们的故事",
  "main": "electron-main.js",
  "scripts": {
    "start": "node app.js",
    "electron": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "com.couple.site",
    "productName": "情侣小站",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app.js",
      "db.js",
      "settings.js",
      "electron-main.js",
      "views/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/img/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "public/img/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/img/icon.png"
    }
  }
}
