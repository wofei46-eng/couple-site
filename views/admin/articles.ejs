<%- include('partials/admin-header') %>

<div class="admin-content">
  <div class="admin-title-row">
    <h1 class="admin-title">日志管理</h1>
    <a href="/admin/articles/new" class="btn btn-primary">+ 写新日记</a>
  </div>
  <div class="admin-card">
    <table class="admin-table">
      <thead>
        <tr><th>标题</th><th>作者</th><th>时间</th><th>操作</th></tr>
      </thead>
      <tbody>
        <% articles.forEach(a => { %>
          <tr>
            <td><%= a.title %></td>
            <td><%= a.author_name %></td>
            <td><%= new Date(a.created_at).toLocaleString('zh-CN') %></td>
            <td class="actions">
              <a href="/articles/<%= a.id %>" target="_blank" class="link">查看</a>
              <a href="/admin/articles/<%= a.id %>/edit" class="link">编辑</a>
              <form action="/admin/articles/<%= a.id %>?_method=DELETE" method="post" style="display:inline" onsubmit="return confirm('确定删除这篇日记吗？')">
                <button class="link link-danger">删除</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
